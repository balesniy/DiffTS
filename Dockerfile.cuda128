FROM nvidia/cuda:12.8.1-cudnn-devel-ubuntu24.04

LABEL org.opencontainers.image.description="DiffTS modern CUDA 12.8 / PyTorch 2.7 stack"
LABEL com.nvidia.cuda.driver.min="570.124.06"

ARG DEBIAN_FRONTEND=noninteractive
ARG PYTHON_VERSION=3.11
ARG USER_ID=1000
ARG GROUP_ID=1000
ARG INSTALL_CUGRAPH=false

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ENV CONDA_DIR=/opt/conda
ENV PATH=/opt/conda/envs/diffts/bin:/opt/conda/bin:${PATH}
ENV TORCH_CUDA_ARCH_LIST="7.5;8.0;8.6;8.9;9.0"
ENV TORCH_NVCC_FLAGS="-Xfatbin -compress-all"
ENV MAX_JOBS=4
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility,graphics

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        cmake \
        curl \
        git \
        libegl1 \
        libeigen3-dev \
        libgl1 \
        libglib2.0-0 \
        libopenblas-dev \
        libx11-6 \
        libxext6 \
        libxrender1 \
        ninja-build \
        openssh-server \
        pybind11-dev \
        tmux \
        wget \
        xauth \
        xterm && \
    rm -rf /var/lib/apt/lists/*

RUN set -eux; \
    case "$(uname -m)" in \
        x86_64) MINIFORGE_ARCH="x86_64" ;; \
        aarch64) MINIFORGE_ARCH="aarch64" ;; \
        *) echo "Unsupported architecture: $(uname -m)" >&2; exit 1 ;; \
    esac; \
    wget -q "https://github.com/conda-forge/miniforge/releases/latest/download/Miniforge3-Linux-${MINIFORGE_ARCH}.sh" -O /tmp/miniforge.sh; \
    bash /tmp/miniforge.sh -b -p "${CONDA_DIR}"; \
    rm /tmp/miniforge.sh; \
    conda create -y -n diffts "python=${PYTHON_VERSION}" pip; \
    conda clean -afy

WORKDIR /packages/DiffTS

RUN python -m pip install --upgrade pip setuptools wheel

COPY requirements/cuda128.txt requirements/cuda128.txt
RUN pip install -r requirements/cuda128.txt

COPY requirements/base.txt requirements/base.txt
RUN pip install -r requirements/base.txt

RUN if [[ "${INSTALL_CUGRAPH}" == "true" ]]; then \
        pip install cugraph-cu12 --extra-index-url=https://pypi.nvidia.com; \
    fi

RUN git clone --recursive https://github.com/NVIDIA/MinkowskiEngine.git /tmp/MinkowskiEngine && \
    cd /tmp/MinkowskiEngine && \
    python setup.py install --force_cuda --blas=openblas && \
    rm -rf /tmp/MinkowskiEngine

COPY . /packages/DiffTS
RUN pip install -e .

RUN if ! getent group "${GROUP_ID}" >/dev/null; then groupadd --gid "${GROUP_ID}" user; fi && \
    useradd --uid "${USER_ID}" --gid "${GROUP_ID}" --create-home --shell /bin/bash user

USER user
WORKDIR /packages/DiffTS/DiffTS
